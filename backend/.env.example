# ========================================================================
# CargoPulse Backend API — Complete Environment Variables Specification
# ========================================================================

# ------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION [MANDATORY]
# ------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION [MANDATORY FOR PERSISTENCE]
# ------------------------------------------------------------------------
# When deployed on Render, Render automatically generates this connection string.
# Fallback: If omitted, the server runs in resilient in-memory mode.
DATABASE_URL="postgresql://postgres:cargopulse_password@localhost:5432/cargopulse_db?schema=public"

# ------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION [MANDATORY]
# ------------------------------------------------------------------------
# Long, random secret key for signing JWT login tokens
JWT_SECRET="cargopulse_super_secret_jwt_key_replace_in_production_987654"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------
# 4. CORS ORIGIN [MANDATORY FOR PRODUCTION]
# ------------------------------------------------------------------------
# Set this to your live Vercel frontend URL so the browser allows API requests
CLIENT_URL="https://your-cargopulse-app.vercel.app"

# ------------------------------------------------------------------------
# 5. SMTP EMAIL DISPATCH [OPTIONAL - ONLY IF YOU WANT REAL EMAILS]
# ------------------------------------------------------------------------
# IF NOT PROVIDED: The system runs in "Simulation Mode" — approval emails
# and directives are rendered with the CargoPulse logo and logged to the
# server terminal and audit ledger without crashing the app.
#
# IF PROVIDED: The system will send real emails directly to recipients' inboxes!
# For Gmail, use an "App Password" (not your normal password):
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-google-app-password
FROM_EMAIL=notifications@cargopulse.io

# ------------------------------------------------------------------------
# 6. EXTERNAL AI ENHANCEMENT [OPTIONAL]
# ------------------------------------------------------------------------
# The AI Copilot answers known question types (stock levels, shipment
# lookups, module how-tos, etc.) instantly via a local, free, always-on
# rule engine — no key needed for that. If you ALSO set one of the keys
# below, the Copilot calls that cloud LLM as a fallback for anything the
# local engine doesn't recognize, so it can answer open-ended questions too.
# Leave both unset and the platform still works fully; only the fallback
# for novel/off-topic questions is skipped.
# OpenAI is tried first if both are set.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------
# 7. REDIS TELEMETRY CACHE [OPTIONAL]
# ------------------------------------------------------------------------
# If omitted, built-in in-memory caching is active.
REDIS_URL="redis://localhost:6379"
