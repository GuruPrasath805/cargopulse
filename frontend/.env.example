# CargoPulse Client — Environment Variables
#
# Local dev: leave VITE_API_URL unset. Vite's dev server proxies "/api"
# requests to http://localhost:5000 (see vite.config.ts).
#
# Production (client deployed separately from server, e.g. Vercel + Render):
# set this to your deployed server's public URL + "/api".
VITE_API_URL="https://your-cargopulse-api.onrender.com/api"
