# ========================================================================
# CargoPulse Platform — Complete Environment Variables Specification
# ========================================================================

# ------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION [MANDATORY]
# ------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION [MANDATORY FOR PERSISTENCE]
# ------------------------------------------------------------------------
# When deployed on Render, Render automatically generates this connection string.
# Fallback: If omitted, the server runs in resilient in-memory mode.
DATABASE_URL="postgresql://postgres:cargopulse_password@localhost:5432/cargopulse_db?schema=public"

# ------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION [MANDATORY]
# ------------------------------------------------------------------------
JWT_SECRET="cargopulse_super_secret_jwt_key_replace_in_production_987654"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------
# 4. CORS ORIGIN [MANDATORY FOR PRODUCTION]
# ------------------------------------------------------------------------
CLIENT_URL="https://your-cargopulse-app.vercel.app"

# ------------------------------------------------------------------------
# 5. SMTP EMAIL DISPATCH [OPTIONAL - ONLY IF YOU WANT REAL EMAILS]
# ------------------------------------------------------------------------
# If omitted: Emails are simulated & logged to server audit trail.
# If provided: Real branded emails with CargoPulse logo are sent to recipient inboxes.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-google-app-password
FROM_EMAIL=notifications@cargopulse.io

# ------------------------------------------------------------------------
# 6. EXTERNAL AI ENHANCEMENT [OPTIONAL]
# ------------------------------------------------------------------------
# Local rule engine answers known questions instantly with no key needed.
# Set one of these to let the Copilot fall back to a real cloud LLM for
# anything outside its known question types. OpenAI is tried first if both
# are set. Leave both unset and everything still works, minus that fallback.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------
# 7. REDIS TELEMETRY CACHE [OPTIONAL]
# ------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
